{
  "name": "@remyral/i18n",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Typed TR/EN message catalogs, locale negotiation, plurals and Intl formatters shared by the web console and the master. No runtime dependency. See ADR-0053 and docs/design/i18n-plan.md.",
  "exports": {
    ".": {
      "@remyral/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./all": {
      "@remyral/source": "./src/all.ts",
      "types": "./dist/all.d.ts",
      "default": "./dist/all.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "vitest": "5.0.4"
  }
}
