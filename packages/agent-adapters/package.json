{
  "name": "@remyral/agent-adapters",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Agent runtime adapter contract, truthful capability model (ADR-0008), process ownership, loopback/stdio transports, fake runtime and contract test kit.",
  "exports": {
    ".": {
      "@remyral/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@remyral/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "gen:codex-protocol": "node scripts/gen-codex-protocol.mjs",
    "check:codex-protocol": "node scripts/gen-codex-protocol.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@remyral/protocol": "workspace:*",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "vitest": "5.0.4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "vitest": "5.0.4"
  }
}
