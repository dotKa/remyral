# Local development configuration. Copy is generated by `pnpm dev:keygen` (writes .env with random
# passwords and a TOTP encryption key file). Never commit a real .env; production values come from Coolify.

# --- infra/dev/compose.yaml ---
REMYRAL_PG_USER=remyral
REMYRAL_PG_PASSWORD=change-me-generated-by-dev-keygen
REMYRAL_PG_DB=remyral
REMYRAL_PG_PORT=55432
REMYRAL_REDIS_PASSWORD=change-me-generated-by-dev-keygen
REMYRAL_REDIS_PORT=56379

# --- apps/master ---
NODE_ENV=development
MASTER_HOST=127.0.0.1
MASTER_PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://remyral:change-me-generated-by-dev-keygen@127.0.0.1:55432/remyral
REDIS_URL=redis://:change-me-generated-by-dev-keygen@127.0.0.1:56379/0
# Path to a file holding a base64-encoded 32-byte key (AES-256-GCM for TOTP secrets, HMAC pepper for
# recovery codes). `pnpm dev:keygen` writes the absolute path of infra/dev/secrets/totp.key here.
TOTP_KEY_FILE=/absolute/path/to/infra/dev/secrets/totp.key
# Number of reverse proxies in front of the master whose X-Forwarded-For is trusted (0 = none).
TRUST_PROXY_HOPS=0
# CDN client-IP header (cf-connecting-ip, true-client-ip or x-real-ip), honoured only when the peer that
# reached the outermost trusted proxy is in TRUSTED_CLIENT_IP_SOURCES (comma-separated CIDRs; needs
# TRUST_PROXY_HOPS >= 1). Production values: infra/coolify/compose.yaml.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
# TRUSTED_CLIENT_IP_SOURCES=173.245.48.0/20,2400:cb00::/32
# p2-identity-rotation (ADR-0005 §5): "true" makes a rotated worker key wait for an admin approval.
WORKER_ROTATION_REQUIRES_APPROVAL=false
# p4-leases (ADR-0004): Ed25519 private key (PKCS#8 PEM, mode 0600) for signing job lease tokens.
# Required in production; `pnpm dev:keygen` writes infra/dev/secrets/lease-signing.pem and this path.
LEASE_SIGNING_KEY_FILE=/absolute/path/to/infra/dev/secrets/lease-signing.pem
# Lease lifetime in ms; workers renew at a third of it.
LEASE_TTL_MS=90000
# p10-claude-login-health: minutes a job waits for a signed-out runtime to be logged in again (0: fail at once).
LOGIN_WAIT_MINUTES=30
# p4-git-flow (docs/ops/github-app.md). Preferred: Settings > Integrations > Connect GitHub (needs PUBLIC_ORIGIN;
# the key is stored encrypted by the master, ADR-0022). Alternative: App id + private key file (mode 0600).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/etc/remyral/github-app.pem
# GITHUB_API_URL=https://api.github.com
# Plain git remotes make the master fetch repository objects into GITFLOW_CACHE_DIR (no checkout); off by default.
# GITFLOW_PLAIN_GIT=false
# GITFLOW_CACHE_DIR=/var/lib/remyral/gitflow-cache
# p6-deploy-integrations (ADR-0028): Coolify / Cloudflare tokens are entered in Settings → Integrations, not here.
# Exact origins the ops client may reach over http / private addresses (e.g. Coolify on the control-plane host):
# OPS_INTERNAL_ORIGINS=
# Remyral's own Coolify resources (never deployed by an ops action) and the control-plane public IP(s):
# OPS_CONTROL_PLANE_COOLIFY_UUIDS=
# OPS_CONTROL_PLANE_ADDRESSES=
# Extra host names protected like the console host (the PUBLIC_ORIGIN host is always protected), comma-separated:
# OPS_PROTECTED_HOSTS=console-old.example.com
# p2-signed-updates: release public key(s) printed by `node scripts/release/sign.mjs keygen`
# (base64url, comma-separated, at most two during a rotation). Unset: release uploads are refused.
# RELEASE_PUBLIC_KEYS=
# p6-skills: skills public key(s) printed by `node scripts/skills/sign.mjs keygen` (separate from the
# release key; at most two). Unset: skill uploads are refused and jobs get no skills.
# SKILLS_PUBLIC_KEYS=
# p5-machine-admin (ADR-0021): panel-held Ed25519 key (PKCS#8 PEM, chmod 600) that signs chat-authored skills an
# administrator confirms; workers trust it through their signed managed configuration. Generate on the host:
#   openssl genpkey -algorithm ed25519 -out skills-panel.pem
# Unset: chat skill drafts are refused (offline-signed uploads keep working).
# SKILLS_PANEL_KEY_FILE=/run/secrets/remyral/skills-panel.pem
# p5-notifications (docs/design/p5-notifications.md): in-app notifications are always on; outbound
# channels stay disabled unless configured. Secrets are read from files, never from the environment.
# NOTIFY_INTERVAL_MS=15000
# NOTIFY_PUBLIC_URL=https://remyral.example.com
# E-mail (TLS required: starttls on 587 or tls on 465; certificates are always verified).
# NOTIFY_SMTP_HOST=smtp.example.com
# NOTIFY_SMTP_PORT=587
# NOTIFY_SMTP_SECURITY=starttls
# NOTIFY_SMTP_FROM=remyral@example.com
# NOTIFY_SMTP_USERNAME=remyral
# NOTIFY_SMTP_PASSWORD_FILE=/run/secrets/smtp-password
# NOTIFY_SMTP_CA_FILE=/etc/remyral/private-ca.pem
# Generic webhook: comma-separated https:// URL prefixes users may register; HMAC key file (>= 32 bytes).
# NOTIFY_WEBHOOK_ALLOWLIST=https://hooks.example.com/remyral/
# NOTIFY_WEBHOOK_SECRET_FILE=/run/secrets/notify-webhook-hmac
# p8-pwa Web Push (docs/design/p8-pwa.md §5): VAPID EC P-256 private key (generate once:
# `pnpm --filter @remyral/master vapid:keygen /abs/path/vapid.pem`) and the operator contact; both or neither.
# PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/remyral/vapid.pem
# PUSH_VAPID_SUBJECT=mailto:ops@example.com
# Optional override of the allowed push services (default: FCM, Mozilla, Apple, WNS).
# PUSH_ENDPOINT_ALLOWLIST=https://fcm.googleapis.com,https://updates.push.services.mozilla.com,https://web.push.apple.com,https://*.notify.windows.com

# p6-otel (docs/design/p6-observability.md): OTLP/HTTP export is off unless an endpoint is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS_FILE=/run/secrets/otlp-headers   # name=value lines, e.g. an API key
# Prometheus /metrics on a separate internal listener (default 127.0.0.1:9464; never routed by Traefik).
# METRICS_ENABLED=true
# METRICS_HOST=127.0.0.1
# METRICS_PORT=9464
# METRICS_TOKEN_FILE=/run/secrets/metrics-token              # required bearer token when set
# p5-remember-device: "Trust this device" lifetime and "Remember me" session idle/absolute lifetime, in
# days (0 disables the feature; idle must not exceed absolute). docs/design/p5-remember-device.md
# AUTH_TRUSTED_DEVICE_DAYS=30
# AUTH_REMEMBER_IDLE_DAYS=7
# AUTH_REMEMBER_ABSOLUTE_DAYS=30
# p5-stepup-window: step-up (fresh TOTP) window of a standard session in minutes (1..60), and of a
# remember-me / trusted-device session: `session` (one TOTP holds for the session), minutes (1..1440) or
# `off` (standard window). Account-security actions always need a TOTP from the last 10 minutes.
# docs/design/p5-remember-device.md §8
# AUTH_STEP_UP_MINUTES=10
# AUTH_STEP_UP_TRUSTED=session
# p6-alerts: operational alarm evaluation period (0 disables).
# ALERT_INTERVAL_MS=60000
# p6-agentmagnify: optional job-lifecycle forwarding (metadata only); both must be set to enable.
# AGENTMAGNIFY_API_URL=https://api.agentmagnify.example
# AGENTMAGNIFY_TOKEN_FILE=/run/secrets/agentmagnify-token
# AGENTMAGNIFY_PROJECT_NAME=remyral
# p5-coolify-sso (docs/ops/coolify-sso.md): "Open Coolify" with single sign-on. Off unless set.
# SSO_CONSOLE_ORIGIN=https://console.example.com           # OIDC issuer = this + /api/oidc
# OIDC_SIGNING_KEY_FILE=/run/secrets/remyral/oidc-signing.pem   # RSA >= 2048 bit, PEM (RS256)
# OIDC_COOLIFY_CLIENT_SECRET_FILE=/run/secrets/remyral/coolify-oidc-client-secret   # >= 32 chars
# OIDC_COOLIFY_REDIRECT_URIS=https://coolify.example.com/auth/oidc/callback
# OIDC_EMAIL_MAP=admin=owner@example.com                   # username=e-mail of the Coolify account
# COOLIFY_SSO_HOST=coolify.example.com                     # forward-auth gate host
# p6-vector: optional semantic search over consented context namespaces (docs/design/p6-vector.md).
# none (default) | local-hash (in-process, no network) | http (OpenAI-compatible /v1/embeddings).
# SEARCH_PROVIDER=none
# SEARCH_HTTP_URL=https://api.voyageai.com/v1/embeddings
# SEARCH_HTTP_MODEL=voyage-4-large
# SEARCH_HTTP_KEY_FILE=/run/secrets/embedding-key
# SEARCH_HTTP_DIMENSIONS=
# SEARCH_INDEX_INTERVAL_MS=60000
# p10-semantic-memory: Amazon Bedrock embeddings — the documented provider (docs/design/p10-semantic-memory.md §3).
# SEARCH_PROVIDER=bedrock
# SEARCH_BEDROCK_REGION=us-east-1                    # same region as the control plane; falls back to AWS_REGION
# SEARCH_BEDROCK_MODEL=cohere.embed-multilingual-v3   # or cohere.embed-v4:0 / amazon.titan-embed-text-v2:0
# SEARCH_BEDROCK_DIMENSIONS=                          # v4: 256|512|1024|1536, Titan V2: 256|512|1024
# Credentials: the AWS SDK default chain. Either the keys of an IAM user allowed only bedrock:InvokeModel on the
# embedding model (secrets; master only) — or nothing, when the EC2 instance has an instance profile (preferred).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Memory suggestions (projects opt in under Projects → <project> → Memory).
# MEMORY_SUGGEST_INTERVAL_MS=60000                    # 0 = no pass over finished jobs
# MEMORY_DUPLICATE_THRESHOLD=0.9                      # cosine at or above = duplicate of existing memory
# MEMORY_AUTO_LEARN=on                                # off = no automatic acceptance / merging (p17-auto-learning)
# RELATED_WORK=on                                     # off = no similar jobs, solved failures, duplicate checks (p17-embeddings)
# RELATED_WORK_CONTEXT=on                             # off = similar past jobs are not added to job contexts (p17-embeddings)

# p13-fleet-tools: read the latest tool / runtime versions from npm, GitHub releases, NuGet and nodejs.org every 6 h
# (no credentials). `off` for masters without outbound internet.
# FLEET_TOOLS_FEED=on
