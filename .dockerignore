# Build context for apps/master/Dockerfile and apps/web/Dockerfile (context = repo root).
# Allow-list style: nothing secret, generated or host-specific may enter an image layer.
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo
**/.turbo
**/playwright-report
**/test-results
.git
.gitignore
.claude
.agentmagnify*
.DS_Store
**/.DS_Store

# Secrets and local configuration — never in a build context.
.env
.env.*
!.env.example
**/secrets
**/*.pem
**/*.key
infra/dev/secrets

# Not needed to build the control-plane images.
docs
infra
scripts
**/e2e
**/test
**/*.md
# p10-backup-restore: the backup runner (infra/backup/Dockerfile copies it; plain .mjs, no secrets).
!infra/backup/runner
