  "links": [],
  "panels": [
    {
      "id": 101,
      "type": "row",
      "title": "Jobs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "Jobs by state",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "remyral-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "remyral-prometheus"
          },
          "expr": "sum by (state) (remyral_jobs{state=~\"QUEUED|RESERVED|RUNNING|VERIFYING|AWAITING_APPROVAL|BLOCKED\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
