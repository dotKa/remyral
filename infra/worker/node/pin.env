# The ONE place the Node.js version for worker machines is pinned (p5-worker-onboarding).
#
# Read (never sourced/executed) by infra/worker/node/install-node.sh (Linux, macOS),
# infra/worker/windows/install.ps1, scripts/release (installer kits) and checked by
# scripts/security/node-pin.mjs (part of `pnpm security:pins`; --online re-downloads SHASUMS256.txt
# from nodejs.org and verifies its OpenPGP signature with the vendored release keys in keys/).
#
# Refresh: node scripts/security/node-pin.mjs --update 24.x.y   (online; verifies the signature
# with the vendored keys before writing anything). Format: KEY=value, no quotes, no spaces.
NODE_VERSION=24.22.1
NODE_DIST_URL=https://nodejs.org/dist
# SHA-256 of v$NODE_VERSION/SHASUMS256.txt whose detached signature (SHASUMS256.txt.sig) was verified
# against keys/ when this pin was written. Installers refuse a SHASUMS256.txt with another hash.
NODE_SHASUMS256_SHA256=fdfbffc969c0f604beff0124d409b33a43b53f5c681d6220f80023e0d6df9dc4
# Fingerprint of the release key that signed that SHASUMS256.txt (must be in keys/keys.list).
NODE_SIGNER=5BE8A3F6C8A5C01D106C0AD820B1A390B168D356
# Per-platform archives (lines of SHASUMS256.txt). Raspberry Pi = linux-arm64 (64-bit OS only).
NODE_SHA256_linux_x64=eb6728e77c576a35162c122c45ccadf224d89ff00abc8dae46cc2897c6002d7c
NODE_SHA256_linux_arm64=33c37be234ba8bee041961047b19160f4d7d0f164e8e246f78bdd10feff148b3
NODE_SHA256_darwin_x64=d132557e7ee2b85af08b0c8c34338e65c6430f2238d01f727728ef42dc83b035
NODE_SHA256_darwin_arm64=89c682593d76cd44233fa53b1563264e7de9cbb189cad169135c5b4fadfbc0a7
NODE_SHA256_win_x64=d2046d28c2c3dcd211ac5145c0bf30e2047ef9dfb306693c8c6e2eccd8b95fa5
