# Remyral worker - privileged sandbox preparation (p5-sandbox-ops, ADR-0019). Installed by
# infra/worker/linux/install.sh, which puts the absolute path of the system-wide Node 24 binary in front of ExecStart.
# Design: docs/design/p5-sandbox-ops.md   Owner guide: docs/ops/worker-sandbox.md
#
# Started by remyral-worker-prepare.path when the worker hands over a signed `sandbox.prepare` command. The
# updater bundle verifies the master's signature on that command itself (pinned masterLeaseKeys, else the keys
# the master publishes over TLS), refuses replays and expired commands, and runs only its fixed allowlist:
# sandbox.workerUser / keepHome in the root-owned config, Podman from the distribution's packages, subordinate
# ids for the worker user. Unlike the update unit it needs the network (package downloads) and writes /etc and
# /usr; it never runs worker code and takes no argument from the request.

[Unit]
Description=Remyral worker sandbox preparation (signed requests only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=@NODE@ /opt/remyral-worker/remyral-worker-updater.mjs prepare --config /etc/remyral-worker/config.json
TimeoutStartSec=45min
UMask=0022
StandardOutput=journal
StandardError=journal
SyslogIdentifier=remyral-worker-prepare
NoNewPrivileges=no
ProtectHome=true
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
