# Remyral worker — privileged updater (p2-signed-updates). Installed by infra/worker/linux/install.sh,
# which puts the absolute path of the system-wide Node 24 binary in front of ExecStart.
# Design: docs/design/p2-signed-updates.md   Owner guide: docs/ops/worker-updates.md
#
# Started by remyral-worker-update.path when the worker writes an activation request, and once at boot
# (resumes a health check interrupted by a reboot). It runs as root because the install dir is
# root-owned and read-only for the worker; it re-verifies the staged release (signature with its own
# pinned keys, SHA-256, channel, downgrade/floor, Node) before it activates anything, restarts
# remyral-worker.service, checks its health and rolls back on failure. It never runs worker code itself.

[Unit]
Description=Remyral worker updater (signed releases)
After=remyral-worker.service

[Service]
Type=oneshot
User=root
ExecStart=@NODE@ /opt/remyral-worker/remyral-worker-updater.mjs apply --config /etc/remyral-worker/config.json
# Stop of the worker (60 s) + start + health check (updates.healthTimeoutSec, max 900 s) twice on rollback.
TimeoutStartSec=40min
# Installed files must stay world-readable for the worker account.
UMask=0022
StandardOutput=journal
StandardError=journal
SyslogIdentifier=remyral-worker-updater

# --- Hardening: it only needs to read the worker's data dir, write the install dir and talk to
# systemd over its private socket. No network at all (it downloads nothing).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/remyral-worker
ReadOnlyPaths=/var/lib/remyral-worker
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# Root still needs to read the service account's 0700 data dir; nothing else.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
