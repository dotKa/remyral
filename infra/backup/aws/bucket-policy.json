{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProdInstanceRoleCreateAndRead",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::PROD_ACCOUNT_ID:role/instanceRole" },
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::BACKUP_BUCKET/remana/*"
    },
    {
      "Sid": "ProdInstanceRoleListPrefix",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::PROD_ACCOUNT_ID:role/instanceRole" },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BACKUP_BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["remana/*"] } }
    },
    {
      "Sid": "ProdCreateOnlyNoOverwrite",
      "Effect": "Deny",
      "Principal": { "AWS": "arn:aws:iam::PROD_ACCOUNT_ID:root" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BACKUP_BUCKET/*",
      "Condition": { "Null": { "s3:if-none-match": "true" } }
    },
    {
      "Sid": "ProdNeverDeleteOrWeaken",
      "Effect": "Deny",
      "Principal": { "AWS": "arn:aws:iam::PROD_ACCOUNT_ID:root" },
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:BypassGovernanceRetention",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketAcl",
        "s3:PutEncryptionConfiguration",
        "s3:DeleteBucket"
      ],
      "Resource": ["arn:aws:s3:::BACKUP_BUCKET", "arn:aws:s3:::BACKUP_BUCKET/*"]
    },
    {
      "Sid": "TLSOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::BACKUP_BUCKET", "arn:aws:s3:::BACKUP_BUCKET/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
