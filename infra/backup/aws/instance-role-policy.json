{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RemanaBackupWriteRead",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::BACKUP_BUCKET/remana/*",
      "Condition": {
        "StringEquals": { "s3:ResourceAccount": "BACKUP_ACCOUNT_ID" }
      }
    },
    {
      "Sid": "RemanaBackupList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BACKUP_BUCKET",
      "Condition": {
        "StringEquals": { "s3:ResourceAccount": "BACKUP_ACCOUNT_ID" },
        "StringLike": { "s3:prefix": ["remana/*"] }
      }
    }
  ]
}
